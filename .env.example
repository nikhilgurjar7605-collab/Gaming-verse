# ai-companion-bot configuration — copy to .env and fill in REAL values.
# NEVER commit your .env file. All secrets live here or in Render's env panel.

# --- Telegram -----------------------------------------------------------
# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Long random string; must match what you register with setWebhook.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET_TOKEN=generate-a-long-random-secret-here
# Public HTTPS base URL of your deployment (no trailing slash, no /webhook).
# Local dev with a tunnel e.g. https://abc123.ngrok.io ; Render e.g. https://ai-companion-bot.onrender.com
WEBHOOK_URL=https://your-app-url

# --- LLM provider (any OpenAI-compatible chat-completions API) ----------
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=500

# --- PostgreSQL ----------------------------------------------------------
# Local: postgres://user:pass@localhost:5432/companion_bot
# Render: use the External Database URL provided by your Render Postgres instance.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/companion_bot

# --- Conversation limits ----------------------------------------------------
HISTORY_WINDOW=20
MAX_MESSAGE_LENGTH=6000
MEMORY_LIMIT_PER_USER=200

# --- Rate limiting (per user) -----------------------------------------------
RATE_LIMIT_MESSAGES=12
RATE_LIMIT_WINDOW_SECONDS=60

# --- Misc ----------------------------------------------------------------------
LOG_LEVEL=INFO
